# Copy to .env (never committed — .gitignore covers it) and fill in.
# These are the operator's inputs; everything else is in the repository.

# ── OP-04 · the Base Sepolia demo deployment ────────────────────────────────

# The deployer key. Use a FRESH key for testnet — never a key that holds real
# funds. For mainnet later, deploy from the operations multisig instead: the
# factory's admin is the broadcaster and is not transferable.
PRIVATE_KEY=

# RPC. The public endpoint works; an Alchemy/Infura/QuickNode URL is steadier.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=

# Contract verification on BaseScan. Free key: https://basescan.org/myapikey
# (an Etherscan account key works across their chains).
BASESCAN_API_KEY=

# Optional overrides for DeployStack / DeployDemoToken — every one has a
# sensible default; see script/README.md for the full table.
# ADMIN=
# TOKEN_NAME=
# TOKEN_SYMBOL=
# UPGRADE_DELAY=
